   215	
   216	    /// Delete the operation at the current cursor.
   217	    pub fn delete_operation(&mut self) {
   218	        if !self.operations.is_empty() {
   219	            self.operations.remove(self.op_cursor);
   220	            if self.op_cursor >= self.operations.len() && self.op_cursor > 0 {
   221	                self.op_cursor -= 1;
   222	            }
   223	            self.update_preview();
   224	        }
   225	    }
   226	
   227	    /// Move the operation at cursor up in the stack.
   228	    pub fn move_operation_up(&mut self) {
   229	        if self.op_cursor > 0 {
   230	            self.operations.swap(self.op_cursor, self.op_cursor - 1);
   231	            self.op_cursor -= 1;
   232	            self.update_preview();
   233	        }
   234	    }
   235	
   236	    /// Move the operation at cursor down in the stack.
   237	    pub fn move_operation_down(&mut self) {
   238	        if self.op_cursor + 1 < self.operations.len() {
   239	            self.operations.swap(self.op_cursor, self.op_cursor + 1);
   240	            self.op_cursor += 1;
   241	            self.update_preview();
   242	        }
   243	    }
   244	
   245	    /// Check for naming conflicts in the preview.
   246	    /// Returns indices of conflicting entries.
   247	    pub fn find_conflicts(&self) -> Vec<usize> {
   248	        let mut conflicts = Vec::new();
   249	        for (i, (_, new_a)) in self.preview.iter().enumerate() {
   250	            for (j, (_, new_b)) in self.preview.iter().enumerate() {
   251	                if i != j && new_a == new_b {
   252	                    conflicts.push(i);
   253	                    break;
   254	                }
   255	            }
   256	            if new_a.is_empty() {
   257	                conflicts.push(i);
   258	                continue;
   259	            }
   260	            if new_a.contains('/') || new_a.contains('\0') {
   261	                conflicts.push(i);
   262	            }
   263	        }
   264	        conflicts
   265	    }
   266	
   267	    /// Whether execution is blocked (conflicts exist).
   268	    pub fn has_errors(&self) -> bool {
   269	        !self.find_conflicts().is_empty()
   270	    }
   271	}
   272	
   273	/// Simple glob-style wildcard matching.
   274	/// `*` matches zero or more characters, `?` matches exactly one character.
   275	fn wildcard_match(pattern: &str, text: &str) -> bool {
   276	    let p: Vec<char> = pattern.chars().collect();
   277	    let t: Vec<char> = text.chars().collect();
   278	    let (plen, tlen) = (p.len(), t.len());
   279	
   280	    // dp[i][j] = pattern[0..i] matches text[0..j]
   281	    let mut dp = vec![vec![false; tlen + 1]; plen + 1];
   282	    dp[0][0] = true;
   283	
   284	    // Leading *s can match empty
   285	    for i in 1..=plen {
   286	        if p[i - 1] == '*' {
   287	            dp[i][0] = dp[i - 1][0];
   288	        }
   289	    }
   290	
   291	    for i in 1..=plen {
   292	        for j in 1..=tlen {
   293	            if p[i - 1] == '*' {
   294	                dp[i][j] = dp[i - 1][j] || dp[i][j - 1];
   295	            } else if p[i - 1] == '?' || p[i - 1] == t[j - 1] {
   296	                dp[i][j] = dp[i - 1][j - 1];
   297	            }
   298	        }
   299	    }
   300	
   301	    dp[plen][tlen]
   302	}

