   382	fn handle_help(app: &mut App, key: KeyEvent) {
   383	    match key.code {
   384	        KeyCode::Esc | KeyCode::Char('?') | KeyCode::Char('q') => {
   385	            app.input_mode = InputMode::Normal;
   386	        }
   387	        _ => {}
   388	    }
