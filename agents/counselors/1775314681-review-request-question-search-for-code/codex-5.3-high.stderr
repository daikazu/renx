   476	fn render_param_editor(frame: &mut Frame, app: &App, area: Rect) {
   477	    let field_count = app.popup_fields.len() as u16;
   478	    let height = 4 + field_count * 2;
   479	    let popup = centered_rect(48, height, area);
   480	    frame.render_widget(Clear, popup);
   481	
   482	    let title = if app.editing_op_index.is_some() {
   483	        " Edit Operation "
   484	    } else {
   485	        " Operation Parameters "
   486	    };
   487	    let block = Block::default()
   488	        .title(Line::from(vec![
   489	            Span::styled(title, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   490	        ]))
   491	        .borders(Borders::ALL)
   492	        .border_style(Style::default().fg(ACCENT));
   493	
   494	    let inner = block.inner(popup);
   495	    frame.render_widget(block, popup);
   496	
   497	    let labels = get_field_labels(app);
   498	
   499	    let mut lines: Vec<Line> = Vec::new();
   500	    for (i, label) in labels.iter().enumerate() {
   501	        let is_focused = i == app.popup_field_cursor;
   502	        let label_style = Style::default().fg(TEXT_DIM);
   503	
   504	        lines.push(Line::from(Span::styled(
   505	            format!("  {}", label),
   506	            label_style,
   507	        )));
   508	
   509	        // Check if this field is a selector
   510	        let is_selector = app
   511	            .popup_field_options
   512	            .get(i)
   513	            .map(|o| o.is_some())
   514	            .unwrap_or(false);
   515	
   516	        if is_selector {
   517	            let options = app.popup_field_options[i].as_ref().unwrap();
   518	            let sel = app.popup_field_selections.get(i).copied().unwrap_or(0);
   519	            let mut spans = vec![Span::raw("  ")];
   520	            if is_focused {
   521	                spans.push(Span::styled("\u{25c0} ", Style::default().fg(ACCENT)));
   522	            } else {
   523	                spans.push(Span::raw("  "));
   524	            }
   525	            for (j, opt) in options.iter().enumerate() {
   526	                if j > 0 {
   527	                    spans.push(Span::styled("  ", Style::default()));
   528	                }
   529	                if j == sel {
   530	                    spans.push(Span::styled(
   531	                        opt.clone(),
   532	                        Style::default()
   533	                            .fg(ACCENT)
   534	                            .bg(BG_HIGHLIGHT)
   535	                            .add_modifier(Modifier::BOLD),
   536	                    ));
   537	                } else {
   538	                    spans.push(Span::styled(opt.clone(), Style::default().fg(TEXT_DIM)));
   539	                }
   540	            }
   541	            if is_focused {
   542	                spans.push(Span::styled(" \u{25b6}", Style::default().fg(ACCENT)));
   543	            }
   544	            lines.push(Line::from(spans));
   545	        } else {
   546	            // Text input field — render as a visible input box with cursor
   547	            let value = app.popup_fields.get(i).map(|s| s.as_str()).unwrap_or("");
   548	            let text_cursor = app.popup_text_cursors.get(i).copied().unwrap_or(value.len());
   549	            let field_width: usize = 38;
   550	
   551	            let bg = if is_focused { BG_HIGHLIGHT } else { Color::Rgb(35, 35, 50) };
   552	            let fg = if is_focused { TEXT } else { TEXT_DIM };
   553	            let border_color = if is_focused { ACCENT } else { BORDER_INACTIVE };
   554	
   555	            let mut spans = vec![
   556	                Span::raw("  "),
   557	                Span::styled("\u{2502}", Style::default().fg(border_color)),
   558	                Span::styled(" ", Style::default().bg(bg)),
   559	            ];
   560	
   561	            if is_focused {
   562	                let before = &value[..text_cursor.min(value.len())];
   563	                let after = &value[text_cursor.min(value.len())..];
   564	                spans.push(Span::styled(before, Style::default().fg(fg).bg(bg)));
   565	                spans.push(Span::styled("\u{258e}", Style::default().fg(ACCENT).bg(bg)));
   566	                let pad_len = field_width.saturating_sub(before.len() + after.len() + 1);
   567	                spans.push(Span::styled(after, Style::default().fg(fg).bg(bg)));
   568	                spans.push(Span::styled(" ".repeat(pad_len), Style::default().bg(bg)));
   569	            } else {
   570	                let pad_len = field_width.saturating_sub(value.len());
   571	                spans.push(Span::styled(value, Style::default().fg(fg).bg(bg)));
   572	                spans.push(Span::styled(" ".repeat(pad_len), Style::default().bg(bg)));
   573	            }
   574	
   575	            spans.push(Span::styled("\u{2502}", Style::default().fg(border_color)));
   576	            lines.push(Line::from(spans));
   577	        }
   578	    }
   579	
   580	    lines.push(Line::from(""));
   581	    lines.push(Line::from(vec![
   582	        Span::styled("  Enter", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   583	        Span::styled(" confirm ", Style::default().fg(TEXT_DIM)),
   584	        Span::styled("\u{2502} ", Style::default().fg(BORDER_INACTIVE)),
   585	        Span::styled("Esc", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   586	        Span::styled(" cancel ", Style::default().fg(TEXT_DIM)),
   587	        Span::styled("\u{2502} ", Style::default().fg(BORDER_INACTIVE)),
   588	        Span::styled("Tab", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   589	        Span::styled(" next", Style::default().fg(TEXT_DIM)),
   590	    ]));
   591	
   592	    let content = Paragraph::new(lines);
   593	    frame.render_widget(content, inner);
   594	}
