    86	fn render_file_panel(frame: &mut Frame, app: &mut App, area: Rect) {
    87	    let focused = app.focused_panel == Panel::Files;
    88	    let is_filtering = app.input_mode == InputMode::Filtering;
    89	    let has_filter = !app.filter_text.is_empty() || is_filtering;
    90	
    91	    // Split area: optional filter bar at top, file list below
    92	    let (filter_area, list_area) = if has_filter {
    93	        let [f, l] = Layout::default()
    94	            .direction(Direction::Vertical)
    95	            .constraints([Constraint::Length(1), Constraint::Fill(1)])
    96	            .areas(area);
    97	        (Some(f), l)
    98	    } else {
    99	        (None, area)
   100	    };
   101	
   102	    // Render filter bar if active
   103	    if let Some(filter_rect) = filter_area {
   104	        let cursor = if is_filtering { "\u{258e}" } else { "" };
   105	        let line = Line::from(vec![
   106	            Span::styled(" / ", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   107	            Span::styled(&app.filter_text, Style::default().fg(TEXT)),
   108	            Span::styled(cursor, Style::default().fg(ACCENT)),
   109	            Span::styled(
   110	                if is_filtering { "  Esc: clear  Enter: confirm" } else { "  / to edit  Esc: clear" },
   111	                Style::default().fg(TEXT_DIM),
   112	            ),
   113	        ]);
   114	        let bar = Paragraph::new(line).style(Style::default().bg(BG_HIGHLIGHT));
   115	        frame.render_widget(bar, filter_rect);
   116	    }
   117	
   118	    // File list (uses filtered indices)
   119	    let (border_color, title_style) = if focused || is_filtering {
   120	        (ACCENT, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD))
   121	    } else {
   122	        (BORDER_INACTIVE, Style::default().fg(TEXT_DIM))
   123	    };
   124	    let block = Block::default()
   125	        .title(Line::from(vec![
   126	            Span::styled(" \u{f016} ", title_style),
   127	            Span::styled("Files ", title_style),
   128	        ]))
   129	        .borders(Borders::ALL)
   130	        .border_style(Style::default().fg(border_color));
   131	
   132	    // Record visible height and ensure cursor is visible
   133	    app.file_list_height = block.inner(list_area).height as usize;
   134	    app.ensure_file_cursor_visible();
   135	
   136	    let visible_end = (app.file_scroll + app.file_list_height).min(app.filtered_indices.len());
   137	    let visible_slice = &app.filtered_indices[app.file_scroll..visible_end];
   138	
   139	    let items: Vec<ListItem> = visible_slice
   140	        .iter()
   141	        .enumerate()
   142	        .map(|(i, &actual_idx)| {
   143	            let display_idx = app.file_scroll + i;
   144	            let file = &app.files[actual_idx];
   145	            let selected = app.selected[actual_idx];
   146	            let is_cursor = display_idx == app.file_cursor && (focused || is_filtering);
   147	
   148	            let check = if selected { "\u{25cf} " } else { "\u{25cb} " };
   149	            let cursor_marker = if is_cursor { "\u{25b8} " } else { "  " };
   150	
   151	            let style = if is_cursor {
   152	                Style::default().fg(TEXT).bg(BG_HIGHLIGHT)
   153	            } else if selected {
   154	                Style::default().fg(TEXT)
   155	            } else {
   156	                Style::default().fg(TEXT_DIM)
   157	            };
   158	
   159	            let check_style = if selected { GREEN } else { TEXT_DIM };
   160	
   161	            ListItem::new(Line::from(vec![
   162	                Span::styled(cursor_marker, style),
   163	                Span::styled(check, Style::default().fg(check_style).bg(if is_cursor { BG_HIGHLIGHT } else { Color::Reset })),
   164	                Span::styled(&file.file_name, style),
   165	            ]))
   166	        })
   167	        .collect();
   168	
   169	    let list = List::new(items).block(block);
   170	    frame.render_widget(list, list_area);
   171	}
