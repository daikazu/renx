   390	
   391	fn build_operation_from_fields(app: &App) -> Option<Operation> {
   392	    let fields = &app.popup_fields;
   393	    match app.popup_type_cursor {
   394	        0 => Some(Operation::FindReplace(FindReplace {
   395	            search: fields.get(0)?.clone(),
   396	            replacement: fields.get(1)?.clone(),
   397	        })),
   398	        1 => Some(Operation::RegexReplace(RegexReplace {
   399	            pattern: fields.get(0)?.clone(),
   400	            replacement: fields.get(1)?.clone(),
   401	        })),
   402	        2 => {
   403	            let width: u32 = fields.get(0)?.parse().unwrap_or(3);
   404	            let start: u32 = fields.get(1)?.parse().unwrap_or(1);
   405	            let position = match fields.get(2)?.as_str() {
   406	                "suffix" => NumberPosition::Suffix,
   407	                "replace" => NumberPosition::Replace,
   408	                _ => NumberPosition::Prefix,
   409	            };
   410	            Some(Operation::SequentialNumber(SequentialNumber {
   411	                format_width: width,
   412	                start,
   413	                position,
   414	            }))
   415	        }
   416	        3 => {
   417	            let mode = match fields.get(0)?.as_str() {
   418	                "upper" => CaseMode::Upper,
   419	                "title" => CaseMode::Title,
   420	                _ => CaseMode::Lower,
   421	            };
   422	            Some(Operation::CaseChange(CaseChange { mode }))
   423	        }
   424	        4 => Some(Operation::AddPrefix(AddPrefix {
   425	            prefix: fields.get(0)?.clone(),
   426	        })),
   427	        5 => Some(Operation::AddSuffix(AddSuffix {
   428	            suffix: fields.get(0)?.clone(),
   429	        })),
   430	        6 => Some(Operation::RemovePattern(RemovePattern {
   431	            pattern: fields.get(0)?.clone(),
   432	        })),
   433	        7 => {
   434	            let sep = fields.get(0)?.clone();
   435	            Some(Operation::Slugify(Slugify {
   436	                separator: if sep.is_empty() { "-".to_string() } else { sep },
   437	            }))
   438	        }
   439	        _ => None,
   440	    }
   441	}
   442	
   443	/// Set up popup_fields, popup_field_options, and popup_field_selections
   444	/// for the current popup_type_cursor. Used when adding a new operation.
   445	fn setup_fields_for_type(app: &mut App) {
   446	    match app.popup_type_cursor {
   447	        0 => { // Find & Replace
   448	            app.popup_fields = vec![String::new(); 2];
   449	            app.popup_field_options = vec![None, None];
   450	            app.popup_field_selections = vec![0, 0];
   451	        }
   452	        1 => { // Regex Replace
   453	            app.popup_fields = vec![String::new(); 2];
   454	            app.popup_field_options = vec![None, None];
   455	            app.popup_field_selections = vec![0, 0];
   456	        }
   457	        2 => { // Sequential Number
   458	            app.popup_fields = vec![String::new(), String::new(), String::new()];
   459	            app.popup_field_options = vec![
   460	                None,
   461	                None,
   462	                Some(vec!["prefix".into(), "suffix".into(), "replace".into()]),
   463	            ];
   464	            app.popup_field_selections = vec![0, 0, 0];
   465	        }
   466	        3 => { // Case Change
   467	            app.popup_fields = vec![String::new()];
   468	            app.popup_field_options = vec![
   469	                Some(vec!["lower".into(), "upper".into(), "title".into()]),
   470	            ];
   471	            app.popup_field_selections = vec![0];
   472	        }
   473	        4 => { // Add Prefix
   474	            app.popup_fields = vec![String::new()];
   475	            app.popup_field_options = vec![None];
   476	            app.popup_field_selections = vec![0];
   477	        }
   478	        5 => { // Add Suffix
   479	            app.popup_fields = vec![String::new()];
   480	            app.popup_field_options = vec![None];
   481	            app.popup_field_selections = vec![0];
   482	        }
   483	        6 => { // Remove Pattern
   484	            app.popup_fields = vec![String::new()];
   485	            app.popup_field_options = vec![None];
   486	            app.popup_field_selections = vec![0];
   487	        }
   488	        7 => { // Slugify
   489	            app.popup_fields = vec![String::new()];
   490	            app.popup_field_options = vec![
   491	                Some(vec!["-".into(), "_".into(), ".".into()]),
   492	            ];
   493	            app.popup_field_selections = vec![0];
   494	        }
   495	        _ => {
   496	            app.popup_fields = Vec::new();
   497	            app.popup_field_options = Vec::new();
   498	            app.popup_field_selections = Vec::new();
   499	        }
   500	    }
   501	    app.popup_text_cursors = vec![0; app.popup_fields.len()];
   502	}
   503	
   504	fn start_editing_operation(app: &mut App) {
   505	    let op = app.operations[app.op_cursor].clone();
   506	    let type_idx = match &op {
   507	        Operation::FindReplace(_) => 0,
   508	        Operation::RegexReplace(_) => 1,
   509	        Operation::SequentialNumber(_) => 2,
   510	        Operation::CaseChange(_) => 3,
   511	        Operation::AddPrefix(_) => 4,
   512	        Operation::AddSuffix(_) => 5,
   513	        Operation::RemovePattern(_) => 6,
   514	        Operation::Slugify(_) => 7,
   515	    };
   516	    app.popup_type_cursor = type_idx;
   517	    setup_fields_for_type(app);
   518	
   519	    // Pre-fill values from the existing operation
   520	    match &op {
   521	        Operation::FindReplace(o) => {
   522	            app.popup_fields[0] = o.search.clone();
   523	            app.popup_fields[1] = o.replacement.clone();
   524	        }
   525	        Operation::RegexReplace(o) => {
   526	            app.popup_fields[0] = o.pattern.clone();
   527	            app.popup_fields[1] = o.replacement.clone();
   528	        }
   529	        Operation::SequentialNumber(o) => {
   530	            app.popup_fields[0] = o.format_width.to_string();
   531	            app.popup_fields[1] = o.start.to_string();
   532	            app.popup_field_selections[2] = match o.position {
   533	                NumberPosition::Prefix => 0,
   534	                NumberPosition::Suffix => 1,
   535	                NumberPosition::Replace => 2,
   536	            };
   537	        }
   538	        Operation::CaseChange(o) => {
   539	            app.popup_field_selections[0] = match o.mode {
   540	                CaseMode::Lower => 0,
   541	                CaseMode::Upper => 1,
   542	                CaseMode::Title => 2,
   543	            };
   544	        }
   545	        Operation::AddPrefix(o) => {
   546	            app.popup_fields[0] = o.prefix.clone();
   547	        }
   548	        Operation::AddSuffix(o) => {
   549	            app.popup_fields[0] = o.suffix.clone();
   550	        }
   551	        Operation::RemovePattern(o) => {
   552	            app.popup_fields[0] = o.pattern.clone();
   553	        }
   554	        Operation::Slugify(o) => {
   555	            app.popup_field_selections[0] = match o.separator.as_str() {
   556	                "_" => 1,
   557	                "." => 2,
   558	                _ => 0,
   559	            };
   560	        }
   561	    }
   562	
   563	    // Set text cursors to end of each pre-filled value
   564	    app.popup_text_cursors = app.popup_fields.iter().map(|f| f.len()).collect();
   565	    app.popup_field_cursor = 0;
   566	    app.editing_op_index = Some(app.op_cursor);
   567	    app.input_mode = InputMode::EditingOperationParams;
   568	}
   569	
   570	fn execute_renames(app: &mut App) {
   571	    let mut success = 0;
   572	    let mut failures: Vec<String> = Vec::new();
   573	
   574	    for (old_name, new_name) in &app.preview {
   575	        if old_name == new_name {
   576	            continue;
   577	        }
   578	        if let Some(entry) = app.files.iter().find(|f| f.file_name == *old_name) {
   579	            match crate::files::rename_file(entry, new_name) {
   580	                Ok(_) => success += 1,
   581	                Err(e) => failures.push(format!("{}: {}", old_name, e)),
   582	            }
   583	        }
   584	    }
   585	
   586	    if failures.is_empty() {
   587	        app.status_message = format!("Renamed {} files successfully", success);
   588	    } else {
   589	        app.status_message = format!(
   590	            "Renamed {} files, {} failed: {}",
   591	            success,
   592	            failures.len(),
   593	            failures.first().unwrap_or(&String::new())
   594	        );
   595	    }
   596	    app.executed = true;
   597	    app.should_quit = true;
   598	}

