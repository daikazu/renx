     7	/// Represents a file that can be renamed.
     8	#[derive(Clone, Debug)]
     9	pub struct FileEntry {
    10	    pub file_name: String,
    11	    pub parent_dir: PathBuf,
    12	}
    13	
    14	impl FileEntry {
    15	    pub fn full_path(&self) -> PathBuf {
    16	        self.parent_dir.join(&self.file_name)
    17	    }
    18	}
    19	
    20	/// Discover all files (not directories) in a directory.
    21	pub fn discover_dir(path: &Path) -> io::Result<Vec<FileEntry>> {
    22	    let mut entries = Vec::new();
    23	    for entry in fs::read_dir(path)? {
    24	        let entry = entry?;
    25	        if entry.file_type()?.is_file() {
    26	            if let Some(name) = entry.file_name().to_str() {
    27	                entries.push(FileEntry {
    28	                    file_name: name.to_string(),
    29	                    parent_dir: path.to_path_buf(),
    30	                });
    31	            }
    32	        }
    33	    }
    34	    entries.sort_by(|a, b| a.file_name.cmp(&b.file_name));
    35	    Ok(entries)
    36	}
    37	
    38	/// Discover files matching a glob pattern.
    39	pub fn discover_glob(pattern: &str) -> io::Result<Vec<FileEntry>> {
    40	    let mut entries = Vec::new();
    41	    let paths = glob(pattern).map_err(|e| io::Error::new(io::ErrorKind::InvalidInput, e))?;
    42	
    43	    for path_result in paths {
    44	        let path = path_result.map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
    45	        if path.is_file() {
    46	            if let (Some(parent), Some(name)) = (path.parent(), path.file_name()) {
    47	                if let Some(name_str) = name.to_str() {
    48	                    entries.push(FileEntry {
    49	                        file_name: name_str.to_string(),
    50	                        parent_dir: parent.to_path_buf(),
    51	                    });
    52	                }
    53	            }
    54	        }
    55	    }
    56	    entries.sort_by(|a, b| a.file_name.cmp(&b.file_name));
    57	    Ok(entries)
    58	}
    59	
    60	/// Rename a single file on disk.
    61	pub fn rename_file(entry: &FileEntry, new_name: &str) -> io::Result<()> {
    62	    let old_path = entry.full_path();
    63	    let new_path = entry.parent_dir.join(new_name);
    64	    fs::rename(old_path, new_path)
    65	}

