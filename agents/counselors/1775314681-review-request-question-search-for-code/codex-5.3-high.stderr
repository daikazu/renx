    12	    /// Apply all operations in order to each filename.
    13	    /// Returns a Vec of transformed filenames in the same order as input.
    14	    pub fn apply(&self, filenames: &[String]) -> Vec<String> {
    15	        filenames
    16	            .iter()
    17	            .enumerate()
    18	            .map(|(index, name)| {
    19	                let mut result = name.clone();
    20	                for op in &self.operations {
    21	                    result = op.apply_with_index(&result, index);
    22	                }
    23	                result
    24	            })
    25	            .collect()
    26	    }
    27	}

