   194	pub struct Slugify {
   195	    pub separator: String,
   196	}
   197	
   198	impl Slugify {
   199	    fn apply(&self, filename: &str) -> String {
   200	        // Split stem and extension
   201	        let (stem, ext) = match filename.rfind('.') {
   202	            Some(dot_pos) => (&filename[..dot_pos], &filename[dot_pos..]),
   203	            None => (filename, ""),
   204	        };
   205	
   206	        // Lowercase, replace non-alphanumeric with separator, collapse, trim
   207	        let slug: String = stem
   208	            .to_lowercase()
   209	            .chars()
   210	            .map(|c| if c.is_ascii_alphanumeric() { c } else { self.separator.chars().next().unwrap_or('-') })
   211	            .collect();
   212	
   213	        let sep_char = self.separator.chars().next().unwrap_or('-');
   214	        let mut result = String::new();
   215	        let mut prev_was_sep = true; // trim leading
   216	        for c in slug.chars() {
   217	            if c == sep_char {
   218	                if !prev_was_sep {
   219	                    result.push(c);
   220	                    prev_was_sep = true;
   221	                }
   222	            } else {
   223	                result.push(c);
   224	                prev_was_sep = false;
   225	            }
   226	        }
   227	        // Trim trailing separator
   228	        while result.ends_with(sep_char) {
   229	            result.pop();
   230	        }
   231	
   232	        format!("{}{}", result, ext.to_lowercase())
   233	    }
   234	}
   235	
   236	impl SequentialNumber {
   237	    fn apply(&self, filename: &str, index: usize) -> String {
   238	        let number = self.start + index as u32;
   239	        let formatted = format!("{:0>width$}", number, width = self.format_width as usize);
   240	
   241	        match self.position {
   242	            NumberPosition::Prefix => format!("{}_{}", formatted, filename),
   243	            NumberPosition::Suffix => match filename.rfind('.') {
   244	                Some(dot_pos) => {
   245	                    let stem = &filename[..dot_pos];
   246	                    let ext = &filename[dot_pos..];
   247	                    format!("{}_{}{}", stem, formatted, ext)
   248	                }
   249	                None => format!("{}_{}", filename, formatted),
   250	            },
   251	            NumberPosition::Replace => match filename.rfind('.') {
   252	                Some(dot_pos) => {
   253	                    let ext = &filename[dot_pos..];
   254	                    format!("{}{}", formatted, ext)
   255	                }
   256	                None => formatted,
   257	            },
   258	        }
   259	    }
   260	}

