    17	
    18	fn handle_normal_mode(app: &mut App, key: KeyEvent) {
    19	    match key.code {
    20	        KeyCode::Char('q') => {
    21	            app.should_quit = true;
    22	        }
    23	        KeyCode::Tab => {
    24	            app.next_panel();
    25	        }
    26	        KeyCode::BackTab => {
    27	            app.prev_panel();
    28	        }
    29	        KeyCode::Char('?') => {
    30	            app.input_mode = InputMode::HelpOverlay;
    31	        }
    32	        KeyCode::Char('/') => {
    33	            app.input_mode = InputMode::Filtering;
    34	            // Don't clear existing filter — user can continue editing it
    35	        }
    36	        KeyCode::Char('X') => {
    37	            // Force rename — skip confirmation, ignore conflicts
    38	            if app.preview.is_empty() {
    39	                app.status_message = "No files to rename".to_string();
    40	            } else {
    41	                execute_renames(app);
    42	            }
    43	        }
    44	        KeyCode::Char('x') => {
    45	            if app.preview.is_empty() {
    46	                app.status_message = "No files to rename".to_string();
    47	            } else if app.has_errors() {
    48	                app.status_message = "Cannot execute: conflicts detected".to_string();
    49	            } else {
    50	                app.input_mode = InputMode::ConfirmExecute;
    51	            }
    52	        }
    53	        _ => match app.focused_panel {
    54	            Panel::Files => handle_files_input(app, key),
    55	            Panel::Operations => handle_ops_input(app, key),
    56	            Panel::Preview => handle_preview_input(app, key),
    57	        },
    58	    }
    59	}
