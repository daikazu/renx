    59	fn render_top_bar(frame: &mut Frame, app: &App, area: Rect) {
    60	    let dir = app
    61	        .files
    62	        .first()
    63	        .map(|f| f.parent_dir.display().to_string())
    64	        .unwrap_or_else(|| ".".to_string());
    65	
    66	    let showing = if app.filtered_indices.len() != app.files.len() {
    67	        format!("  showing {}/{}", app.filtered_indices.len(), app.files.len())
    68	    } else {
    69	        format!("  {} files", app.files.len())
    70	    };
    71	
    72	    let text = Line::from(vec![
    73	        Span::styled(" renx ", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
    74	        Span::styled("\u{2502} ", Style::default().fg(BORDER_INACTIVE)),
    75	        Span::styled(format!("{}", dir), Style::default().fg(TEXT)),
    76	        Span::styled(showing, Style::default().fg(TEXT_DIM)),
    77	        Span::styled(
    78	            format!("  \u{2714} {}", app.selected_count()),
    79	            Style::default().fg(GREEN),
    80	        ),
    81	    ]);
    82	    let bar = Paragraph::new(text).style(Style::default().bg(BG_BAR));
    83	    frame.render_widget(bar, area);
    84	}
