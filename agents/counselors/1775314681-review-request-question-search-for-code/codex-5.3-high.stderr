   179	    pub fn next_panel(&mut self) {
   180	        self.focused_panel = match self.focused_panel {
   181	            Panel::Files => Panel::Operations,
   182	            Panel::Operations => Panel::Preview,
   183	            Panel::Preview => Panel::Files,
   184	        };
   185	    }
   186	
   187	    pub fn prev_panel(&mut self) {
   188	        self.focused_panel = match self.focused_panel {
   189	            Panel::Files => Panel::Preview,
   190	            Panel::Operations => Panel::Files,
   191	            Panel::Preview => Panel::Operations,
