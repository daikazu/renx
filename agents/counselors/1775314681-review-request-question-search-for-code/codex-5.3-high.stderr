    21	    fs::write(dir.path().join("photo.png"), "").unwrap();
    22	    fs::write(dir.path().join("notes.txt"), "").unwrap();
    23	
    24	    let pattern = dir.path().join("*.jpg").to_string_lossy().to_string();
