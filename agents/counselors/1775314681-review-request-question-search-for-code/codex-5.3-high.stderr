    53	/// Expand ~ to $HOME
    54	fn expand_tilde(s: &str) -> String {
    55	    if s.starts_with("~/") || s == "~" {
    56	        if let Some(home) = std::env::var_os("HOME") {
    57	            return format!("{}{}", home.to_string_lossy(), &s[1..]);
    58	        }
    59	    }
    60	    s.to_string()
    61	}
    62	
    63	/// Figure out the directory and optional filter from CLI args.
    64	///
    65	/// Three cases:
    66	///   1. Single arg, is a directory         -> (dir, None)
    67	///   2. Single arg, contains wildcards     -> (parent_dir, Some(filter))
    68	///   3. Multiple args (shell-expanded)     -> (common_parent, None)
    69	fn resolve_args(args: &Args) -> (String, Option<String>) {
    70	    // Single argument
    71	    if args.patterns.len() == 1 {
    72	        let expanded = expand_tilde(&args.patterns[0]);
    73	        let path = Path::new(&expanded);
    74	
    75	        // Directory
    76	        if path.is_dir() {
    77	            return (expanded.trim_end_matches('/').to_string(), None);
    78	        }
    79	
    80	        // Quoted glob pattern (wildcards survived the shell)
    81	        if expanded.contains('*') || expanded.contains('?') {
    82	            let first_wild = expanded
    83	                .find(|c: char| c == '*' || c == '?')
    84	                .unwrap_or(expanded.len());
    85	            let dir_end = expanded[..first_wild].rfind('/');
    86	
    87	            return match dir_end {
    88	                Some(pos) => {
    89	                    let dir = &expanded[..pos];
    90	                    let filter = &expanded[pos + 1..];
    91	                    (
    92	                        if dir.is_empty() { ".".to_string() } else { dir.to_string() },
    93	                        Some(filter.to_string()),
    94	                    )
    95	                }
    96	                None => (".".to_string(), Some(expanded)),
    97	            };
    98	        }
    99	
   100	        // Treat as directory path even if it doesn't exist yet
   101	        return (expanded, None);
   102	    }
   103	
   104	    // Multiple arguments — shell expanded the glob.
   105	    // Extract parent dir and try to reconstruct the filter pattern.
   106	    let expanded: Vec<String> = args.patterns.iter().map(|p| expand_tilde(p)).collect();
   107	    let first_path = Path::new(&expanded[0]);
   108	    let dir = first_path
   109	        .parent()
   110	        .map(|p| p.to_string_lossy().to_string())
   111	        .unwrap_or_else(|| ".".to_string());
   112	    let dir = if dir.is_empty() { ".".to_string() } else { dir };
   113	
   114	    // Try to infer filter: if all files share a common extension, use *.ext
   115	    // If all filenames contain a common substring, use *substring*
   116	    let filenames: Vec<String> = expanded
   117	        .iter()
   118	        .filter_map(|p| Path::new(p).file_name().map(|f| f.to_string_lossy().to_string()))
   119	        .collect();
   120	
   121	    let filter = infer_filter(&filenames);
   122	
   123	    (dir, filter)
   124	}
   125	
   126	/// Try to reconstruct a wildcard filter from shell-expanded filenames.
   127	/// e.g. all ".jpeg" files -> "*.jpeg", all containing "test" -> "*test*"
   128	fn infer_filter(filenames: &[String]) -> Option<String> {
   129	    if filenames.is_empty() {
   130	        return None;
   131	    }
   132	
   133	    // Check if all share a common extension
   134	    let first_ext = Path::new(&filenames[0])
   135	        .extension()
   136	        .map(|e| e.to_string_lossy().to_string());
   137	
   138	    if let Some(ref ext) = first_ext {
   139	        if filenames.iter().all(|f| {
   140	            Path::new(f)
   141	                .extension()
   142	                .map(|e| e.to_string_lossy().to_string())
   143	                .as_ref()
   144	                == Some(ext)
   145	        }) {
   146	            return Some(format!("*.{}", ext));
   147	        }
   148	    }
   149	
   150	    // Check if all share a common substring (at least 3 chars) in the stem
   151	    let stems: Vec<String> = filenames
   152	        .iter()
   153	        .filter_map(|f| {
   154	            Path::new(f)
   155	                .file_stem()
   156	                .map(|s| s.to_string_lossy().to_lowercase())
   157	        })
   158	        .collect();
   159	
   160	    if stems.len() >= 2 {
   161	        // Find longest common substring across all stems
   162	        let first = &stems[0];
   163	        for len in (3..=first.len()).rev() {
   164	            for start in 0..=first.len() - len {
   165	                let candidate = &first[start..start + len];
   166	                if stems.iter().all(|s| s.contains(candidate)) {
   167	                    return Some(format!("*{}*", candidate));
   168	                }
   169	            }
   170	        }
   171	    }
   172	
   173	    None
   174	}
   175	
   176	/// Load all files from a directory.
   177	fn load_files(dir: &str, recursive: bool) -> io::Result<Vec<files::FileEntry>> {
   178	    let path = Path::new(dir);
   179	    let mut all_files = if recursive {
   180	        let glob_pattern = format!("{}/**/*", dir.trim_end_matches('/'));
   181	        files::discover_glob(&glob_pattern)?
   182	    } else {
   183	        files::discover_dir(path)?
   184	    };
   185	
   186	    all_files.sort_by(|a, b| a.full_path().cmp(&b.full_path()));
   187	    all_files.dedup_by(|a, b| a.full_path() == b.full_path());
   188	
   189	    Ok(all_files)
   190	}
   191	
   192	fn run(terminal: &mut ratatui::DefaultTerminal, app: &mut App) -> io::Result<()> {
   193	    loop {
   194	        terminal.draw(|frame| ui::render(frame, app))?;
   195	
   196	        if let Event::Key(key) = event::read()? {
   197	            if key.kind == KeyEventKind::Press {
   198	                input::handle_key(app, key);
   199	                if app.should_quit {
   200	                    return Ok(());
   201	                }
   202	            }
   203	        }
   204	    }
   205	}

