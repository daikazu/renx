     1	use std::fs;
     2	use renx::app::App;
     3	use renx::files;
     4	use renx::operations::*;
     5	
     6	#[test]
     7	fn end_to_end_rename() {
     8	    let dir = tempfile::tempdir().unwrap();
     9	    fs::write(dir.path().join("IMG_001.jpg"), "").unwrap();
    10	    fs::write(dir.path().join("IMG_002.jpg"), "").unwrap();
    11	    fs::write(dir.path().join("IMG_003.jpg"), "").unwrap();
    12	
    13	    let file_list = files::discover_dir(dir.path()).unwrap();
    14	    let mut app = App::new(file_list);
    15	    app.toggle_select_all();
    16	
    17	    // Add operations: replace IMG_ with beach_, then lowercase
    18	    app.operations.push(Operation::FindReplace(FindReplace {
    19	        search: "IMG_".to_string(),
    20	        replacement: "beach_".to_string(),
    21	    }));
    22	    app.operations.push(Operation::CaseChange(CaseChange {
    23	        mode: CaseMode::Lower,
    24	    }));
    25	    app.update_preview();
    26	
    27	    // Verify preview
    28	    assert_eq!(app.preview.len(), 3);
    29	    assert_eq!(app.preview[0], ("IMG_001.jpg".to_string(), "beach_001.jpg".to_string()));
    30	    assert_eq!(app.preview[1], ("IMG_002.jpg".to_string(), "beach_002.jpg".to_string()));
    31	    assert_eq!(app.preview[2], ("IMG_003.jpg".to_string(), "beach_003.jpg".to_string()));
    32	
    33	    // Execute renames
    34	    assert!(!app.has_errors());
    35	    for (old_name, new_name) in &app.preview {
    36	        let entry = app.files.iter().find(|f| f.file_name == *old_name).unwrap();
    37	        files::rename_file(entry, new_name).unwrap();
    38	    }
    39	
    40	    // Verify files on disk
    41	    assert!(dir.path().join("beach_001.jpg").exists());
    42	    assert!(dir.path().join("beach_002.jpg").exists());
    43	    assert!(dir.path().join("beach_003.jpg").exists());
    44	    assert!(!dir.path().join("IMG_001.jpg").exists());
    45	}
    46	
    47	#[test]
    48	fn conflict_detection_blocks_execution() {
    49	    let dir = tempfile::tempdir().unwrap();
    50	    fs::write(dir.path().join("a.txt"), "").unwrap();
    51	    fs::write(dir.path().join("b.txt"), "").unwrap();
    52	
    53	    let file_list = files::discover_dir(dir.path()).unwrap();
    54	    let mut app = App::new(file_list);
    55	    app.toggle_select_all();
    56	
    57	    // Both files would rename to the same thing
    58	    app.operations.push(Operation::FindReplace(FindReplace {
    59	        search: "a".to_string(),
    60	        replacement: "x".to_string(),
    61	    }));
    62	    app.operations.push(Operation::FindReplace(FindReplace {
    63	        search: "b".to_string(),
    64	        replacement: "x".to_string(),
    65	    }));
    66	    app.update_preview();
    67	
    68	    // Both become "x.txt" — should detect conflict
    69	    assert!(app.has_errors());
    70	}

