    21	
    22	#[test]
    23	fn stacked_operations() {
    24	    let ops = vec![
    25	        Operation::FindReplace(FindReplace {
    26	            search: "IMG_".to_string(),
    27	            replacement: "beach_".to_string(),
    28	        }),
    29	        Operation::CaseChange(CaseChange {
    30	            mode: CaseMode::Lower,
    31	        }),
    32	        Operation::SequentialNumber(SequentialNumber {
    33	            format_width: 3,
    34	            start: 1,
    35	            position: NumberPosition::Prefix,
    36	        }),
    37	    ];
    38	    let pipeline = Pipeline::new(ops);
    39	    let filenames = vec![
    40	        "IMG_0422.JPG".to_string(),
    41	        "IMG_0423.JPG".to_string(),
    42	    ];
    43	    let results = pipeline.apply(&filenames);
    44	    assert_eq!(results, vec!["001_beach_0422.jpg", "002_beach_0423.jpg"]);
