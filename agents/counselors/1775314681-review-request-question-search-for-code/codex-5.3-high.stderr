   602	        4 => vec!["Prefix:"],
   603	        5 => vec!["Suffix:"],
   604	        6 => vec!["Pattern to remove:"],
   605	        7 => vec!["Separator:"],
   606	        _ => vec![],
   607	    }
   608	}
