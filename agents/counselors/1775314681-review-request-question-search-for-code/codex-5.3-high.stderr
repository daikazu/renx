    11	#[test]
    12	fn single_operation() {
    13	    let ops = vec![Operation::FindReplace(FindReplace {
    14	        search: "IMG_".to_string(),
    15	        replacement: "beach_".to_string(),
    16	    })];
    17	    let pipeline = Pipeline::new(ops);
