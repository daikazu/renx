   109	
   110	    /// Rebuild filtered_indices based on current filter_text.
   111	    /// Supports wildcards: `*` matches any chars, `?` matches one char.
   112	    /// If no wildcards are present, falls back to substring match.
   113	    pub fn update_filter(&mut self) {
   114	        let query = self.filter_text.to_lowercase();
   115	        self.filtered_indices = self
   116	            .files
   117	            .iter()
   118	            .enumerate()
   119	            .filter(|(_, f)| {
   120	                if query.is_empty() {
   121	                    return true;
   122	                }
   123	                let name = f.file_name.to_lowercase();
   124	                if query.contains('*') || query.contains('?') {
   125	                    wildcard_match(&query, &name)
   126	                } else {
   127	                    name.contains(&query)
   128	                }
   129	            })
   130	            .map(|(i, _)| i)
   131	            .collect();
   132	        // Keep cursor in bounds
   133	        if self.file_cursor >= self.filtered_indices.len() {
   134	            self.file_cursor = self.filtered_indices.len().saturating_sub(1);
   135	        }
   136	    }
   137	
   138	    /// Keep file_scroll in sync so the cursor is always visible.
   139	    pub fn ensure_file_cursor_visible(&mut self) {
   140	        if self.file_cursor < self.file_scroll {
   141	            self.file_scroll = self.file_cursor;
   142	        } else if self.file_cursor >= self.file_scroll + self.file_list_height {
   143	            self.file_scroll = self.file_cursor - self.file_list_height + 1;
   144	        }
   145	    }
   146	
   147	    /// Get the actual file index for the current cursor position in the filtered list.
   148	    pub fn actual_file_index(&self) -> Option<usize> {
   149	        self.filtered_indices.get(self.file_cursor).copied()
   150	    }
   151	
   152	    /// Recalculate the preview based on current operations and selected files.
   153	    /// Only generates preview when there are operations to apply.
   154	    pub fn update_preview(&mut self) {
   155	        if self.operations.is_empty() {
   156	            self.preview.clear();
   157	            return;
   158	        }
   159	        let pipeline = Pipeline::new(self.operations.clone());
   160	        let selected_files: Vec<String> = self
   161	            .filtered_indices
   162	            .iter()
   163	            .filter(|&&i| self.selected[i])
   164	            .map(|&i| self.files[i].file_name.clone())
   165	            .collect();
   166	        let new_names = pipeline.apply(&selected_files);
   167	        self.preview = selected_files
   168	            .into_iter()
   169	            .zip(new_names.into_iter())
   170	            .collect();
   171	    }
   172	
   173	    /// Count of selected files.
   174	    pub fn selected_count(&self) -> usize {
   175	        self.selected.iter().filter(|&&s| s).count()
   176	    }
   177	
