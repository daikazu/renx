    46	
    47	#[test]
    48	fn pipeline_preserves_order() {
    49	    let ops = vec![
    50	        Operation::FindReplace(FindReplace {
    51	            search: "old".to_string(),
    52	            replacement: "new".to_string(),
    53	        }),
