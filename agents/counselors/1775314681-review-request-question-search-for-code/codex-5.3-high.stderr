   173	fn render_operation_stack(frame: &mut Frame, app: &App, area: Rect) {
   174	    let focused = app.focused_panel == Panel::Operations;
   175	    let (border_color, title_style) = if focused {
   176	        (ACCENT, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD))
   177	    } else {
   178	        (BORDER_INACTIVE, Style::default().fg(TEXT_DIM))
   179	    };
   180	    let block = Block::default()
   181	        .title(Line::from(vec![
   182	            Span::styled(" \u{2630} ", title_style),
   183	            Span::styled("Operations ", title_style),
   184	        ]))
   185	        .borders(Borders::ALL)
   186	        .border_style(Style::default().fg(border_color));
   187	
   188	    if app.operations.is_empty() {
   189	        let hint = Paragraph::new(Line::from(vec![
   190	            Span::styled("  Press ", Style::default().fg(TEXT_DIM)),
   191	            Span::styled("a", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   192	            Span::styled(" to add an operation", Style::default().fg(TEXT_DIM)),
   193	        ]))
   194	        .block(block);
   195	        frame.render_widget(hint, area);
   196	        return;
   197	    }
   198	
   199	    let items: Vec<ListItem> = app
   200	        .operations
   201	        .iter()
   202	        .enumerate()
   203	        .map(|(i, op)| {
   204	            let is_cursor = i == app.op_cursor && focused;
   205	            let num_style = if is_cursor {
   206	                Style::default().fg(ACCENT).bg(BG_HIGHLIGHT).add_modifier(Modifier::BOLD)
   207	            } else {
   208	                Style::default().fg(ACCENT_DIM)
   209	            };
   210	            let text_style = if is_cursor {
   211	                Style::default().fg(TEXT).bg(BG_HIGHLIGHT)
   212	            } else {
   213	                Style::default().fg(YELLOW)
   214	            };
   215	            ListItem::new(Line::from(vec![
   216	                Span::styled(format!(" {}. ", i + 1), num_style),
   217	                Span::styled(op.description(), text_style),
   218	            ]))
   219	        })
   220	        .collect();
   221	
   222	    let list = List::new(items).block(block);
   223	    frame.render_widget(list, area);
   224	}
