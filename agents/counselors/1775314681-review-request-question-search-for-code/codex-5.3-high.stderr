   226	fn render_preview(frame: &mut Frame, app: &mut App, area: Rect) {
   227	    let focused = app.focused_panel == Panel::Preview;
   228	    let (border_color, title_style) = if focused {
   229	        (ACCENT, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD))
   230	    } else {
   231	        (BORDER_INACTIVE, Style::default().fg(TEXT_DIM))
   232	    };
   233	    let block = Block::default()
   234	        .title(Line::from(vec![
   235	            Span::styled(" \u{25b6} ", title_style),
   236	            Span::styled("Preview ", title_style),
   237	        ]))
   238	        .borders(Borders::ALL)
   239	        .border_style(Style::default().fg(border_color));
   240	
   241	    let conflicts = app.find_conflicts();
   242	
   243	    let inner = block.inner(area);
   244	    app.preview_height = inner.height.saturating_sub(1) as usize; // minus header line
   245	    frame.render_widget(block, area);
   246	
   247	    if app.preview.is_empty() {
   248	        let msg = if app.operations.is_empty() {
   249	            "Add an operation to see preview"
   250	        } else {
   251	            "No files selected"
   252	        };
   253	        let hint = Paragraph::new(Line::from(vec![
   254	            Span::styled(format!("  {}", msg), Style::default().fg(TEXT_DIM)),
   255	        ]));
   256	        frame.render_widget(hint, inner);
   257	        return;
   258	    }
   259	
   260	    let max_old_len = app
   261	        .preview
   262	        .iter()
   263	        .map(|(old, _)| old.len())
   264	        .max()
   265	        .unwrap_or(0)
   266	        .max(8);
   267	
   268	    let mut lines: Vec<Line> = Vec::new();
   269	    let header = Line::from(vec![
   270	        Span::styled(
   271	            format!("  {:<width$}", "Original", width = max_old_len),
   272	            Style::default().fg(TEXT_DIM),
   273	        ),
   274	        Span::styled("  \u{2192}  ", Style::default().fg(BORDER_INACTIVE)),
   275	        Span::styled("Renamed", Style::default().fg(TEXT_DIM)),
   276	    ]);
   277	    lines.push(header);
   278	
   279	    let visible_count = inner.height.saturating_sub(1) as usize;
   280	    let start = app.preview_scroll;
   281	    let end = (start + visible_count).min(app.preview.len());
   282	
   283	    for (display_idx, (old, new)) in app.preview[start..end].iter().enumerate() {
   284	        let actual_idx = start + display_idx;
   285	        let is_conflict = conflicts.contains(&actual_idx);
   286	        let is_noop = old == new;
   287	
   288	        let new_style = if is_conflict {
   289	            Style::default().fg(RED).add_modifier(Modifier::BOLD)
   290	        } else if is_noop {
   291	            Style::default().fg(TEXT_DIM)
   292	        } else {
   293	            Style::default().fg(GREEN)
   294	        };
   295	
   296	        let arrow_style = if is_conflict {
   297	            Style::default().fg(RED)
   298	        } else if is_noop {
   299	            Style::default().fg(BORDER_INACTIVE)
   300	        } else {
   301	            Style::default().fg(ACCENT_DIM)
   302	        };
   303	
   304	        let line = Line::from(vec![
   305	            Span::styled(
   306	                format!("  {:<width$}", old, width = max_old_len),
   307	                Style::default().fg(TEXT),
   308	            ),
   309	            Span::styled("  \u{2192}  ", arrow_style),
   310	            Span::styled(new.clone(), new_style),
   311	        ]);
   312	        lines.push(line);
   313	    }
   314	
   315	    if end < app.preview.len() {
   316	        lines.push(Line::from(Span::styled(
   317	            format!("  \u{22EE} {} more", app.preview.len() - end),
   318	            Style::default().fg(TEXT_DIM),
   319	        )));
   320	    }
   321	
   322	    let preview_text = Paragraph::new(lines);
   323	    frame.render_widget(preview_text, inner);
   324	}
   325	
   326	fn render_bottom_bar(frame: &mut Frame, app: &App, area: Rect) {
   327	    // Show status message if present
   328	    if !app.status_message.is_empty() {
   329	        let line = Line::from(vec![
   330	            Span::styled(format!(" {}", app.status_message), Style::default().fg(YELLOW)),
   331	        ]);
   332	        let bar = Paragraph::new(line).style(Style::default().bg(BG_BAR));
   333	        frame.render_widget(bar, area);
   334	        return;
   335	    }
   336	
   337	    // Filter mode has its own bar
   338	    if app.input_mode == InputMode::Filtering {
   339	        let line = Line::from(vec![
   340	            Span::styled(" Type to filter", Style::default().fg(TEXT_DIM)),
   341	            Span::styled(" \u{2502} ", Style::default().fg(BORDER_INACTIVE)),
   342	            Span::styled("Enter", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   343	            Span::styled(" confirm ", Style::default().fg(TEXT_DIM)),
   344	            Span::styled("\u{2502} ", Style::default().fg(BORDER_INACTIVE)),
   345	            Span::styled("Esc", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)),
   346	            Span::styled(" clear", Style::default().fg(TEXT_DIM)),
   347	        ]);
   348	        let bar = Paragraph::new(line).style(Style::default().bg(BG_BAR));
   349	        frame.render_widget(bar, area);
   350	        return;
   351	    }
   352	
   353	    let hints = match app.focused_panel {
   354	        Panel::Files => vec![
   355	            ("Tab", "switch"), ("/", "filter"), ("Space/Enter", "toggle"), ("v", "all"), ("x", "rename"), ("q", "quit"),
   356	        ],
   357	        Panel::Operations => vec![
   358	            ("Tab", "switch"), ("a", "add"), ("e/Enter", "edit"), ("d", "delete"), ("J/K", "reorder"), ("x", "rename"), ("q", "quit"),
   359	        ],
   360	        Panel::Preview => vec![
   361	            ("Tab", "switch"), ("j/k", "scroll"), ("x", "rename"), ("q", "quit"),
   362	        ],
   363	    };
   364	
   365	    let mut spans: Vec<Span> = vec![Span::raw(" ")];
   366	    for (i, (key, desc)) in hints.iter().enumerate() {
   367	        if i > 0 {
   368	            spans.push(Span::styled(" \u{2502} ", Style::default().fg(BORDER_INACTIVE)));
   369	        }
   370	        spans.push(Span::styled(*key, Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)));
   371	        spans.push(Span::styled(format!(" {}", desc), Style::default().fg(TEXT_DIM)));
   372	    }
   373	
   374	    // Right-aligned help hint
   375	    let left_len: usize = spans.iter().map(|s| s.content.len()).sum();
   376	    let help_text = "? help";
   377	    let padding = (area.width as usize).saturating_sub(left_len).saturating_sub(help_text.len() + 1);
   378	    if padding > 0 {
   379	        spans.push(Span::raw(" ".repeat(padding)));
   380	    }
   381	    spans.push(Span::styled("?", Style::default().fg(ACCENT).add_modifier(Modifier::BOLD)));
   382	    spans.push(Span::styled(" help", Style::default().fg(TEXT_DIM)));
   383	
   384	    let bar = Paragraph::new(Line::from(spans)).style(Style::default().bg(BG_BAR));
   385	    frame.render_widget(bar, area);
   386	}
   387	
   388	fn centered_rect(width: u16, height: u16, area: Rect) -> Rect {
   389	    let x = area.x + (area.width.saturating_sub(width)) / 2;
   390	    let y = area.y + (area.height.saturating_sub(height)) / 2;
   391	    Rect::new(x, y, width.min(area.width), height.min(area.height))
   392	}
