    23	pub fn render(frame: &mut Frame, app: &mut App) {
    24	    let area = frame.area();
    25	
    26	    let [top_bar, main_area, preview_area, bottom_bar] = Layout::default()
    27	        .direction(Direction::Vertical)
    28	        .constraints([
    29	            Constraint::Length(1),
    30	            Constraint::Fill(1),
    31	            Constraint::Percentage(35),
    32	            Constraint::Length(1),
    33	        ])
    34	        .areas(area);
    35	
    36	    let [files_area, ops_area] = Layout::default()
    37	        .direction(Direction::Horizontal)
    38	        .constraints([
    39	            Constraint::Percentage(55),
    40	            Constraint::Percentage(45),
    41	        ])
    42	        .areas(main_area);
    43	
    44	    render_top_bar(frame, app, top_bar);
    45	    render_file_panel(frame, app, files_area);
    46	    render_operation_stack(frame, app, ops_area);
    47	    render_preview(frame, app, preview_area);
    48	    render_bottom_bar(frame, app, bottom_bar);
    49	
    50	    match app.input_mode {
    51	        InputMode::SelectingOperationType => render_type_picker(frame, app, area),
    52	        InputMode::EditingOperationParams => render_param_editor(frame, app, area),
    53	        InputMode::ConfirmExecute => render_confirm(frame, app, area),
    54	        InputMode::HelpOverlay => render_help(frame, area),
    55	        InputMode::Normal | InputMode::Filtering => {}
    56	    }
    57	}
