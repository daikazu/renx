     4	#[test]
     5	fn discover_files_in_directory() {
     6	    let dir = tempfile::tempdir().unwrap();
     7	    fs::write(dir.path().join("a.txt"), "").unwrap();
     8	    fs::write(dir.path().join("b.txt"), "").unwrap();
     9	    fs::create_dir(dir.path().join("subdir")).unwrap();
    10	
    11	    let files = files::discover_dir(dir.path()).unwrap();
    12	    assert_eq!(files.len(), 2);
    13	    assert!(files.iter().any(|f| f.file_name == "a.txt"));
    14	    assert!(files.iter().any(|f| f.file_name == "b.txt"));
    15	}
    16	
    17	#[test]
    18	fn discover_with_glob_pattern() {
    19	    let dir = tempfile::tempdir().unwrap();
