   208	            app.filter_text.pop();
   209	            app.update_filter();
   210	        }
   211	        KeyCode::Char(c) => {
   212	            app.filter_text.push(c);
   213	            app.update_filter();
   214	        }
   215	        _ => {}
   216	    }
   217	}
   218	
   219	fn handle_confirm(app: &mut App, key: KeyEvent) {
   220	    match key.code {
   221	        KeyCode::Char('y') | KeyCode::Char('Y') => {
   222	            app.input_mode = InputMode::Normal;
   223	            execute_renames(app);
   224	        }
   225	        KeyCode::Char('n') | KeyCode::Char('N') | KeyCode::Esc => {
   226	            app.input_mode = InputMode::Normal;
   227	            app.status_message.clear();
   228	        }
   229	        _ => {}
   230	    }
   231	}
   232	
   233	fn handle_type_picker(app: &mut App, key: KeyEvent) {
   234	    match key.code {
   235	        KeyCode::Esc => {
   236	            app.input_mode = InputMode::Normal;
   237	        }
   238	        KeyCode::Char('j') | KeyCode::Down => {
   239	            if app.popup_type_cursor < 7 {
   240	                app.popup_type_cursor += 1;
   241	            }
   242	        }
   243	        KeyCode::Char('k') | KeyCode::Up => {
   244	            if app.popup_type_cursor > 0 {
   245	                app.popup_type_cursor -= 1;
   246	            }
   247	        }
   248	        KeyCode::Enter => {
   249	            setup_fields_for_type(app);
   250	            app.popup_field_cursor = 0;
   251	            app.input_mode = InputMode::EditingOperationParams;
   252	        }
   253	        _ => {}
   254	    }
   255	}
   256	
   257	fn handle_param_editor(app: &mut App, key: KeyEvent) {
   258	    let cursor = app.popup_field_cursor;
   259	    let is_selector = app
   260	        .popup_field_options
   261	        .get(cursor)
   262	        .map(|o| o.is_some())
   263	        .unwrap_or(false);
   264	
   265	    match key.code {
   266	        KeyCode::Esc => {
   267	            app.input_mode = InputMode::Normal;
   268	            app.popup_fields.clear();
   269	        }
   270	        KeyCode::Tab => {
   271	            if !app.popup_fields.is_empty() {
   272	                app.popup_field_cursor = (app.popup_field_cursor + 1) % app.popup_fields.len();
   273	            }
   274	        }
   275	        KeyCode::BackTab => {
   276	            if !app.popup_fields.is_empty() {
   277	                app.popup_field_cursor = if app.popup_field_cursor == 0 {
   278	                    app.popup_fields.len() - 1
   279	                } else {
   280	                    app.popup_field_cursor - 1
   281	                };
   282	            }
   283	        }
   284	        KeyCode::Enter => {
   285	            // Sync selector values into popup_fields before building
   286	            for (i, opts) in app.popup_field_options.iter().enumerate() {
   287	                if let Some(options) = opts {
   288	                    let sel = app.popup_field_selections.get(i).copied().unwrap_or(0);
   289	                    if let Some(val) = options.get(sel) {
   290	                        app.popup_fields[i] = val.clone();
   291	                    }
   292	                }
   293	            }
   294	            if let Some(op) = build_operation_from_fields(app) {
   295	                if let Some(idx) = app.editing_op_index {
   296	                    app.operations[idx] = op;
   297	                } else {
   298	                    app.operations.push(op);
   299	                    app.op_cursor = app.operations.len() - 1;
   300	                }
   301	                app.update_preview();
   302	            }
   303	            app.input_mode = InputMode::Normal;
   304	            app.popup_fields.clear();
   305	            app.editing_op_index = None;
   306	        }
   307	        // Selector fields: left/right to cycle options
   308	        KeyCode::Left if is_selector => {
   309	            if let Some(sel) = app.popup_field_selections.get_mut(cursor) {
   310	                if *sel > 0 {
   311	                    *sel -= 1;
   312	                }
   313	            }
   314	        }
   315	        KeyCode::Right if is_selector => {
   316	            if let Some(options) = &app.popup_field_options[cursor] {
   317	                if let Some(sel) = app.popup_field_selections.get_mut(cursor) {
   318	                    if *sel + 1 < options.len() {
   319	                        *sel += 1;
   320	                    }
   321	                }
   322	            }
   323	        }
   324	        // Text fields: cursor movement
   325	        KeyCode::Left if !is_selector => {
   326	            if let Some(pos) = app.popup_text_cursors.get_mut(cursor) {
   327	                if *pos > 0 {
   328	                    *pos -= 1;
   329	                }
   330	            }
   331	        }
   332	        KeyCode::Right if !is_selector => {
   333	            if let Some(pos) = app.popup_text_cursors.get_mut(cursor) {
   334	                let len = app.popup_fields.get(cursor).map(|f| f.len()).unwrap_or(0);
   335	                if *pos < len {
   336	                    *pos += 1;
   337	                }
   338	            }
   339	        }
   340	        KeyCode::Home if !is_selector => {
   341	            if let Some(pos) = app.popup_text_cursors.get_mut(cursor) {
   342	                *pos = 0;
   343	            }
   344	        }
   345	        KeyCode::End if !is_selector => {
   346	            if let Some(pos) = app.popup_text_cursors.get_mut(cursor) {
   347	                *pos = app.popup_fields.get(cursor).map(|f| f.len()).unwrap_or(0);
   348	            }
   349	        }
   350	        // Text fields: editing
   351	        KeyCode::Backspace if !is_selector => {
   352	            if let Some(pos) = app.popup_text_cursors.get_mut(cursor) {
   353	                if *pos > 0 {
   354	                    if let Some(field) = app.popup_fields.get_mut(cursor) {
   355	                        field.remove(*pos - 1);
   356	                        *pos -= 1;
   357	                    }
   358	                }
   359	            }
   360	        }
   361	        KeyCode::Delete if !is_selector => {
   362	            let pos = app.popup_text_cursors.get(cursor).copied().unwrap_or(0);
   363	            if let Some(field) = app.popup_fields.get_mut(cursor) {
   364	                if pos < field.len() {
   365	                    field.remove(pos);
   366	                }
   367	            }
   368	        }
   369	        KeyCode::Char(c) if !is_selector => {
   370	            let pos = app.popup_text_cursors.get(cursor).copied().unwrap_or(0);
   371	            if let Some(field) = app.popup_fields.get_mut(cursor) {
   372	                field.insert(pos, c);
   373	            }
   374	            if let Some(p) = app.popup_text_cursors.get_mut(cursor) {
   375	                *p += 1;
   376	            }
   377	        }
   378	        _ => {}
   379	    }
   380	}
