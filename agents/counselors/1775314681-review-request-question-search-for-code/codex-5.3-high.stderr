     6	/// Handle a key event and mutate app state accordingly.
     7	pub fn handle_key(app: &mut App, key: KeyEvent) {
     8	    match app.input_mode {
     9	        InputMode::Normal => handle_normal_mode(app, key),
    10	        InputMode::Filtering => handle_filter_mode(app, key),
    11	        InputMode::SelectingOperationType => handle_type_picker(app, key),
    12	        InputMode::EditingOperationParams => handle_param_editor(app, key),
